# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A live dashboard for spool, as routes of a Spindle application"
description:
  "Watch and steer spool's queue from the application that runs it: counts by state and queue, the runners, the queues and their limits, schedules, workflows and a chart of attempts, live, with cancel, retry and delete for a job or a selection. Routes added to a Spindle server behind its own guard; the page is built in and served from memory."
maintainer: ["Hypha Technologies Ltd <dev@hyphatech.io>"]
authors: ["Hypha Technologies Ltd"]
license: "MIT"
homepage: "https://github.com/hyphatech/spool"
bug-reports: "https://github.com/hyphatech/spool/issues"
depends: [
  "dune" {>= "3.18"}
  "ocaml" {>= "5.5"}
  "spool" {= version}
  "spindle" {>= "0.15.0" & < "0.16.0"}
  "spindle-postgres" {>= "0.15.0" & < "0.16.0"}
  "rowtype" {>= "0.10.0" & < "0.11.0"}
  "rowtype-postgres" {>= "0.10.0" & < "0.11.0"}
  "wiretype" {>= "0.7.0" & < "0.8.0"}
  "ppx_wiretype" {>= "0.7.0" & < "0.8.0"}
  "ptime" {>= "1.2.0"}
  "mtime" {>= "2.1.0"}
  "eio" {>= "1.6"}
  "logs" {>= "0.10.0"}
  "crunch" {build & >= "4.1.0"}
  "spindle-http" {with-test & >= "0.15.0" & < "0.16.0"}
  "eio_main" {with-test & >= "1.6"}
  "alcotest" {with-test & >= "1.9.1"}
  "melange" {with-test & >= "7.0.1-55"}
  "mlx" {with-test & >= "0.11"}
  "ppx_solidtype" {with-test & >= "0.11.1" & < "0.12.0"}
  "solidtype" {with-test & >= "0.11.1" & < "0.12.0"}
  "solidtype-heroui" {with-test & >= "0.11.1" & < "0.12.0"}
  "solidtype-rhp" {with-test & >= "0.11.1" & < "0.12.0"}
  "solidtype-gravity-icons" {with-test & >= "0.11.1" & < "0.12.0"}
  "ocamlformat-mlx" {with-dev-setup & = "0.29.0.1"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/hyphatech/spool.git"
x-maintenance-intent: ["(latest)"]
x-open-opam: true
