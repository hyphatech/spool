; Small programs, each showing one thing an application does with spool,
; for the documentation site's pages to import. They are built with the
; repository, so an example that stops compiling as the queue changes is
; found by the build and not by a reader. Each needs a Postgres to run.

(executables
 (names quick_start verify kinds enqueueing runner operating testing)
 (modules :standard \ dashboard spindle)
 (libraries
  spool
  rowtype
  rowtype-postgres
  wiretype
  eio
  eio_main
  ptime
  ptime.clock.os
  mtime
  alcotest))

; The dashboard's example, a Spindle server of its own.

(executable
 (name dashboard)
 (modules dashboard)
 (libraries
  spool
  spool-dashboard
  spindle
  spindle-postgres
  rowtype
  rowtype-postgres
  wiretype
  eio
  eio_main
  ptime
  ptime.clock.os
  mtime))

; spool in a Spindle application: a route that owes a job, and a runner
; beside the server.

(executable
 (name spindle)
 (modules spindle)
 (libraries
  spool
  spindle
  spindle-postgres
  rowtype
  rowtype-postgres
  wiretype
  eio
  eio_main
  ptime
  ptime.clock.os
  mtime))

; @all builds only the modules a program links, and a piece no program links
; would be skipped, so @all asks for this directory's @check, which compiles
; every module.

(rule
 (alias all)
 (deps
  (alias check))
 (action (progn)))
